# Event relay configuration
PORT=8787
# Binds to loopback by default. Set HOST=0.0.0.0 only behind a trusted network boundary.
HOST=127.0.0.1
# Production Railway value: /app/data/quiz.sqlite on a volume mounted at /app/data.
QUIZ_DATABASE_PATH=./data/quiz.sqlite
EVENT_SOURCE=none
# Synthetic local events are disabled unless both settings below are explicit.
MOCK_SOURCE_ENABLED=false
MOCK_INTERVAL_MS=8000
# Set these only when EVENT_SOURCE=youtube
YOUTUBE_API_KEY=
# The relay discovers the channel's current live chat automatically. @ is optional.
# Idle discovery retries after 5, 10, 20, 40, then 60 minutes to protect API quota.
YOUTUBE_CHANNEL_HANDLE=miciodev
# Optional override for a specific broadcast; normally leave this empty.
YOUTUBE_LIVE_CHAT_ID=
POLL_INTERVAL_MS=10000
